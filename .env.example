# Variables d'environnement reconnues par FLAIR (toutes facultatives).
# Le projet ne lit pas de fichier .env : définis-les dans le terminal avant
# de lancer l'application, par exemple sous PowerShell :
#   $env:FLAIR_PSEUDO_SALT = "une-longue-chaine-aleatoire"
# Ne jamais versionner de vraie valeur.

# Sel de pseudonymisation. Sans lui, un sel aléatoire est tiré à chaque
# démarrage : les pseudonymes changent d'une session à l'autre.
FLAIR_PSEUDO_SALT=

# Ollama local (toute adresse non locale est refusée au démarrage)
FLAIR_OLLAMA_URL=http://localhost:11434
FLAIR_MODEL=qwen2.5:7b
FLAIR_OLLAMA_TIMEOUT=180

# 0 = le LLM reste sur le processeur (carte graphique instable). Vide = choix d'Ollama.
FLAIR_NUM_GPU=
